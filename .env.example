# Copy to .env (make setup does this for you).
# offline = no model, free and deterministic. llm = any OpenAI-compatible endpoint.
LLM_MODE=offline

# Local model with Ollama (make up-llm)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL=qwen2.5:7b

# Judge model used by evals (weeks 3-5). Defaults to the same Ollama model.
JUDGE=ollama
JUDGE_MODEL=qwen2.5:7b

# Optional: hosted models instead of Ollama
# OpenAI:        OPENAI_BASE_URL=https://api.openai.com/v1  OPENAI_API_KEY=sk-...  MODEL=gpt-4.1-mini
# Azure/Foundry: OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/  OPENAI_API_KEY=<key>  MODEL=<deployment>

APP_URL=http://localhost:8000
